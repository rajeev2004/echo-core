# Copy to .env and fill in. Never commit .env.

# --- Service keys ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
INWORLD_API_KEY=

# --- Swap points (config, not code) ---
# cascade = STT -> LLM -> TTS ; s2s = Gemini Live
PIPELINE_MODE=cascade
# openai | anthropic | google
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini

# --- Transport ---
# smallwebrtc for all dev; twilio only at step 7
TRANSPORT=smallwebrtc
